<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microfone: essencial para o detector. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Foreground Service com tipo "microphone" (obrigatório a partir do Android 14 / API 34). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Notificação persistente (Android 13+ exige permissão em tempo de execução). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Alarme sonoro + vibração do alerta. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Mantém a CPU acordada durante o monitoramento com a tela bloqueada. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Abrir a tela de alerta por cima da tela de bloqueio. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Sugerir ao usuário que exclua o app da otimização de bateria (opcional, ele decide). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:name=".app.CallDetectorApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.CallDetector"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AlertActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CallDetector.Alert" />

        <activity
            android:name=".ui.DiagnosticActivity"
            android:exported="false"
            android:label="@string/diagnostic_title" />

        <service
            android:name=".service.MonitorService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
